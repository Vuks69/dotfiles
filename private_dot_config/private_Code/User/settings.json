{
    "editor.largeFileOptimizations": false,
    "explorer.confirmDragAndDrop": false,
    "files.autoSave": "onFocusChange",
    "git.confirmSync": false,
    "editor.fontFamily": "Fira Code Retina",
    "editor.fontLigatures": true,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.iconTheme": "catppuccin-mocha",
    "discord.detailsEditing": "Editing {dir_name}/{file_name}",
    "discord.detailsIdling": "Rethinking life choices",
    "files.watcherExclude": {
        "**/node_modules/**": true
    },
    "search.followSymlinks": false,
    "gitblame.extendedHoverInformation": "inline",
    "gitblame.inlineMessageEnabled": true,
    "python.createEnvironment.trigger": "off",
    "nixEnvSelector.useFlakes": true,
    "diffEditor.renderSideBySide": false,
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://models.dev/model-schema.json": true,
        "https://opencode.ai/config.json": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    "extensions.autoUpdate": "off",
    "chat.viewSessions.orientation": "stacked",
    "diffEditor.ignoreTrimWhitespace": true,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ]
}